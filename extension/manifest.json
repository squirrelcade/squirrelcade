{
  "manifest_version": 3,
  "name": "Squirrelcade Deal check",
  "short_name": "Deal check",
  "version": "0.5.1",
  "description": "Shows which games you have in your Squirrelcade on a store's page, with their acorns and PriceCharting's prices: by itself on the stores it reads, and with its button anywhere else.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Check this page in Squirrelcade",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.pricecharting.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "drawer/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Deal check's window"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.ca/*",
        "https://www.walmart.com/*",
        "https://www.walmart.ca/*",
        "https://videogamesplus.ca/*",
        "https://*.videogamesplus.ca/*",
        "https://*.ebay.com/*",
        "https://*.ebay.ca/*",
        "https://www.mercari.com/*",
        "https://www.gamestop.com/*",
        "https://www.target.com/*",
        "https://www.bestbuy.com/*",
        "https://www.bestbuy.ca/*",
        "https://www.gamefly.com/*",
        "https://limitedrungames.com/*",
        "https://*.limitedrungames.com/*",
        "https://superraregames.com/*",
        "https://*.superraregames.com/*",
        "https://www.fangamer.com/*",
        "https://*.woot.com/*",
        "https://www.play-asia.com/*",
        "https://www.estarland.com/*",
        "https://www.dkoldies.com/*",
        "https://www.pnpgames.com/*",
        "https://pnpgames.com/*",
        "https://*.square-enix-games.com/*",
        "https://www.dekudeals.com/*",
        "https://store.playstation.com/*",
        "https://www.xbox.com/*",
        "https://www.microsoft.com/*",
        "https://www.nintendo.com/*",
        "https://www.kinguin.net/*",
        "https://pnpgamesonline.com/*",
        "https://www.pnpgamesonline.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
